{
  "name": "@nathanfrund/nexus",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./core": "./src/core/mod.ts",
    "./ecs": "./src/ecs/mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/mod.ts",
    "dry-run": "deno publish --dry-run"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "publish": {
    "exclude": [
      "tests/",
      "examples/",
      "deno.lock"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
